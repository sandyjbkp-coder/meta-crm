# Meta Lead Ads CRM - environment template
# Copy to .env and fill in real values before starting the server.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- Security (required) ---------------------------------------------------
MASTER_KEY=
JWT_SECRET=

# --- Meta / Facebook Lead Ads ---------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=change-me-webhook-verify-token
DEFAULT_ASSIGNEE_EMAIL=

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
DB_FILE=./data/crm.sqlite

# --- Demo mode ------------------------------------------------------------
DEMO_MODE=true

# Optional: create the very first admin from env (dev convenience only)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
